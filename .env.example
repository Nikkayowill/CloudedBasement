# Runtime
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace_with_64byte_random_hex
SENTRY_DSN=

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webserver_db
DB_USER=postgres
DB_PASSWORD=replace_with_db_password

# Core integrations
DIGITALOCEAN_TOKEN=dop_v1_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider (configure one strategy)
# 1) SendGrid
SENDGRID_API_KEY=

# 2) Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_EMAIL=
GMAIL_SMTP_PORT=465

# 3) Mailtrap
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# 4) Generic SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_REPLY_TO=
FROM_EMAIL=

# Operational notifications
ADMIN_EMAIL=admin@example.com

# WordPress credential encryption (required for WordPress flows)
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WP_ENCRYPTION_KEY=
